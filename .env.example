# Copiá este archivo como .env para configurar la app en tu PC.

# Sin DATABASE_URL se usa un Postgres embebido guardado en ./data (ideal para probar).
# En producción poné la cadena de Neon, por ej.:
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Usuario administrador que se crea la primera vez (si la base está vacía).
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# Secreto para firmar las sesiones. Poné cualquier texto largo y aleatorio.
JWT_SECRET=cambiar-por-un-texto-largo-y-aleatorio

# Nombre que aparece en el encabezado.
EVENT_NAME=Mendotaku

# Duración de la sesión en horas.
SESSION_HOURS=24

PORT=3000
